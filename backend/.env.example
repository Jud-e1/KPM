# Application Configuration
PROJECT_NAME="KPM Full-Stack App"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# CORS Settings (comma-separated or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kpm_db

# Optional direct DATABASE_URL override (if provided, this will be used directly)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kpm_db
