# Application Configuration
PROJECT_NAME="KPM Full-Stack App"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# CORS Settings (comma-separated or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kpm_db

# Optional direct DATABASE_URL override (if provided, this will be used directly)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/kpm_db
# POSTGRES_SSLMODE=prefer

# Redis (summary cache; optional — app works without it)
REDIS_URL=redis://localhost:6379/0
REDIS_SUMMARY_TTL_SECONDS=30

# Auth JWT secret (change in production)
SECRET_KEY=kpm-dev-secret-change-me-in-production-32chars

# Optional: Google Identity Services (OAuth client ID for web)
# GOOGLE_CLIENT_ID=
# Frontend also needs: NEXT_PUBLIC_GOOGLE_CLIENT_ID=<same value>

# Public URLs used in email and OAuth redirects
# PUBLIC_APP_URL=https://kpm-azane.vercel.app
# API_PUBLIC_URL=https://kpm-api.vercel.app

# Email (Resend or SMTP). Leave empty locally; messages are logged and not sent.
# RESEND_API_KEY=
# EMAIL_FROM=KPM <onboarding@resend.dev>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Stripe Growth checkout. Pricing cards stay; paid buttons start checkout when these are set.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_GROWTH_MONTHLY=
# STRIPE_PRICE_GROWTH_YEARLY=

# One-click connector sign-in. Paste-a-key stays when a pair is empty.
# OAUTH_SHOPIFY_CLIENT_ID=
# OAUTH_SHOPIFY_CLIENT_SECRET=
# OAUTH_QUICKBOOKS_CLIENT_ID=
# OAUTH_QUICKBOOKS_CLIENT_SECRET=
# OAUTH_XERO_CLIENT_ID=
# OAUTH_XERO_CLIENT_SECRET=
# OAUTH_AMAZON_CLIENT_ID=
# OAUTH_AMAZON_CLIENT_SECRET=
# OAUTH_WHATSAPP_CLIENT_ID=
# OAUTH_WHATSAPP_CLIENT_SECRET=
# OAUTH_META_SHOP_CLIENT_ID=
# OAUTH_META_SHOP_CLIENT_SECRET=

# Optional: enable real LLM insights (otherwise rules-based answers are used)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Shared secret for ml-service → core /api/v1/ml/internal/* (leave empty for local/dev)
# ML_SERVICE_TOKEN=change-me-ml-service-token
